---
import ConnectIcon, { type ConnectIconName } from "./ConnectIcon.astro";
import { tileTones, type TileTone } from "../data/tiles";

interface Props {
  title: string;
  href: string;
  description?: string;
  image?: string;
  tone?: TileTone;
  bg?: string;
  fg?: string;
  icon?: ConnectIconName;
  external?: boolean;
  featured?: boolean;
  dense?: boolean;
  name?: string;
  delay?: number;
}

const {
  title,
  href,
  description,
  image,
  tone = "ink",
  bg,
  fg,
  icon,
  external = false,
  featured = false,
  dense = false,
  name,
  delay = 0,
} = Astro.props;

const colors = tileTones[tone];
const background = bg ?? colors.bg;
const foreground = fg ?? colors.fg;
const transitionName = name ?? `tile-${href.replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "")}`;

function hexLuminance(hex: string) {
  const raw = hex.replace("#", "").trim();
  const full = raw.length === 3 ? raw.split("").map((c) => c + c).join("") : raw;
  if (!/^[0-9a-fA-F]{6}$/.test(full)) return 1;
  const n = parseInt(full, 16);
  const lin = (v: number) => {
    const s = v / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  };
  return 0.2126 * lin((n >> 16) & 255) + 0.7152 * lin((n >> 8) & 255) + 0.0722 * lin(n & 255);
}

const onDark = hexLuminance(foreground) > 0.42;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  transition:name={transitionName}
  class:list={[
    "color-tile group relative isolate overflow-hidden flex flex-col justify-end rounded-[1.15rem] p-6 md:p-8",
    featured
      ? "min-h-[13.5rem] sm:min-h-[16rem] lg:min-h-full"
      : dense
        ? "min-h-[9.5rem] md:min-h-[11rem]"
        : image
          ? "min-h-[14.5rem] md:min-h-[17rem]"
          : "min-h-[10.5rem] md:min-h-[12.25rem]",
    onDark ? "color-tile--on-dark" : "color-tile--on-light",
    image && "color-tile--has-image",
    dense && "color-tile--dense",
  ]}
  style={`background:${background};color:${foreground};--stagger:${delay}ms`}
>
  {
    image && (
      <img
        src={image}
        alt=""
        class:list={[
          "color-tile-image absolute inset-0 h-full w-full object-cover",
          image.includes("contact-portrait") && "color-tile-image--eyes",
        ]}
        loading="lazy"
      />
    )
  }
  <div class="color-tile-wash absolute inset-0"></div>
  {
    icon && (
      <span class="color-tile-icon" aria-hidden="true">
        <ConnectIcon name={icon} class="h-[1.15rem] w-[1.15rem]" />
      </span>
    )
  }
  <div class="relative z-10">
    <h2
      class:list={[
        "color-tile-title font-display tracking-tight leading-[1.08] text-wrap-balance",
        featured ? "text-[clamp(1.9rem,4.2vw,3.1rem)]" : dense ? "text-[clamp(1.3rem,2.2vw,1.75rem)]" : "text-[clamp(1.55rem,3vw,2.15rem)]",
      ]}
    >
      {title}
      {
        external && !icon && (
          <svg class="ml-1.5 inline-block align-[-0.12em] w-[0.62em] h-[0.62em] opacity-80" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        )
      }
    </h2>
    {
      description && (
        <p class:list={["color-tile-copy mt-3 max-w-md text-sm md:text-[0.95rem] leading-relaxed", dense && "line-clamp-2 mt-2"]}>
          {description}
        </p>
      )
    }
  </div>
</a>
