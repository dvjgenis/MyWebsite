---
import type { CollectionEntry } from "astro:content";
import Quote from "./Quote.astro";
import PageNav from "./PageNav.astro";

interface Crumb {
  label: string;
  href: string;
}

interface Sibling {
  title: string;
  href: string;
}

interface Props {
  page: CollectionEntry<"pages">;
  Content: Astro.Component;
  showDescription?: boolean;
  parent?: Crumb;
  prev?: Sibling;
  next?: Sibling;
}

const { page, Content, showDescription = true, parent, prev, next } = Astro.props;
const { title, quote, quoteAuthor, heroImage } = page.data;
const kind = page.data.slug.split("/").pop() ?? "page";
const hasHero = Boolean(heroImage);
---

<article class:list={["page-article", hasHero && "page-article--banner"]} data-kind={kind} data-slug={page.data.slug}>
  {
    hasHero && (
      <header class="page-hero">
        <div class="page-hero-media">
          <img src={heroImage} alt="" width="1600" height="640" decoding="async" fetchpriority="high" />
        </div>
        <div class="page-hero-copy">
          <h1 class="page-hero-title">{title}</h1>
          {showDescription && page.data.description && <p class="page-hero-dek">{page.data.description}</p>}
        </div>
      </header>
    )
  }

  <div class:list={["page-shell", hasHero && "page-shell--after-banner"]}>
    {
      !hasHero && (
        <header class="page-masthead stagger-in">
          <h1 class="page-title">{title}</h1>
          {showDescription && page.data.description && <p class="page-dek">{page.data.description}</p>}
        </header>
      )
    }
    {
      quote && (
        <div class:list={["page-pullquote", hasHero && "page-pullquote--banner"]}>
          <Quote quote={quote} author={quoteAuthor} />
        </div>
      )
    }

  <slot name="after-intro" />

  <div class="page-layout stagger-in" style="animation-delay: 120ms">
    <nav class="page-index" data-page-index hidden>
      <p class="page-index-kicker">On this page</p>
      <div class="page-index-links"></div>
    </nav>
    <div class="prose-site page-entries" data-page-entries>
      <Content />
    </div>
  </div>

  <PageNav parent={parent} prev={prev} next={next} />
  </div>
</article>

<script>
  let observer;

  function addLink(container, card, extraClass = "") {
    const id = card.getAttribute("data-anchor");
    const label = card.getAttribute("data-label") || id;
    if (!id || !label) return;
    const a = document.createElement("a");
    a.href = `#${id}`;
    a.className = extraClass ? `page-index-link ${extraClass}` : "page-index-link";
    a.textContent = label;
    a.dataset.target = id;
    container.append(a);
  }

  function initPageIndex() {
    observer?.disconnect();
    const nav = document.querySelector("[data-page-index]");
    const root = document.querySelector("[data-page-entries]");
    if (!nav || !root) return;

    const links = nav.querySelector(".page-index-links");
    if (!links) return;
    links.replaceChildren();

    const cards = [...root.querySelectorAll(".entry-card")];
    if (cards.length < 3) {
      nav.hidden = true;
      return;
    }

    nav.hidden = false;
    for (const child of root.children) {
      if (child.classList.contains("entry-group-label")) {
        const a = document.createElement("a");
        a.href = `#${child.id}`;
        a.className = "page-index-link page-index-link--group";
        a.textContent = child.textContent.trim();
        a.dataset.target = child.id;
        links.append(a);
        continue;
      }
      if (
        child.classList.contains("entry-mosaic") ||
        child.classList.contains("site-carousel--resource") ||
        child.classList.contains("site-carousel--food")
      ) {
        const mosaicCards = [
          ...child.querySelectorAll(".entry-card:not(.entry-card--person):not(.entry-card--photo)"),
        ];
        mosaicCards.forEach((card) => addLink(links, card));
        continue;
      }
      if (child.classList.contains("entry-card") && !child.classList.contains("entry-card--person")) {
        addLink(links, child);
      }
    }

    if (!links.children.length) {
      nav.hidden = true;
      return;
    }

    const targets = [...root.querySelectorAll(".entry-card h2[id], .entry-group-label[id]")];
    observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        const id = visible[0]?.target?.id;
        if (!id) return;
        links.querySelectorAll(".page-index-link").forEach((link) => {
          link.classList.toggle("is-active", link.dataset.target === id);
        });
      },
      { rootMargin: "-22% 0px -62% 0px", threshold: 0 },
    );
    targets.forEach((el) => observer.observe(el));
  }

  function classifyImage(img) {
    if (!img.naturalWidth || !img.naturalHeight) return;
    const ar = img.naturalWidth / img.naturalHeight;
    img.classList.toggle("is-frame", ar > 0.82 && ar < 1.22);
    img.classList.toggle("is-banner", ar > 2.2);
    img.classList.toggle("is-landscape", ar >= 1.15 && ar <= 2.2);
    img.classList.toggle("is-portrait", ar < 0.85);

    const person = img.closest(".entry-card--person, .entry-card--profile");
    if (person) {
      img.style.objectPosition = ar < 0.92 ? "center 28%" : "center 42%";
    }
  }

  function markMediaFrames() {
    document
      .querySelectorAll(
        ".entry-media img, .entry-stills img, .spread-row img, .essay-figure img, .page-hero-media img, .site-carousel img",
      )
      .forEach((node) => {
        const img = node;
        if (img.complete) classifyImage(img);
        else img.addEventListener("load", () => classifyImage(img), { once: true });
      });
  }

  document.addEventListener("astro:page-load", initPageIndex);
  document.addEventListener("astro:page-load", markMediaFrames);
  document.addEventListener("astro:page-load", initCarousels);
  initPageIndex();
  markMediaFrames();
  initCarousels();

  function pauseSlideMedia(slide) {
    slide?.querySelectorAll("iframe").forEach((iframe) => {
      iframe.contentWindow?.postMessage(JSON.stringify({ event: "command", func: "pauseVideo", args: [] }), "*");
    });
  }

  function initCarousels() {
    document.querySelectorAll(".site-carousel").forEach(enhanceCarousel);
  }

  function enhanceCarousel(root) {
    if (root.dataset.enhanced === "true") return;
    const track = root.querySelector(":scope > .site-carousel-frame > .site-carousel-track");
    const slides = track ? [...track.children].filter((node) => node.classList.contains("site-carousel-slide")) : [];
    if (!track || slides.length < 2) return;
    root.dataset.enhanced = "true";

    const prev = root.querySelector(":scope > .site-carousel-frame > .site-carousel-btn--prev");
    const next = root.querySelector(":scope > .site-carousel-frame > .site-carousel-btn--next");
    const dots = [...root.querySelectorAll(":scope > .site-carousel-nav .site-carousel-dot")];
    const count = root.querySelector(":scope > .site-carousel-nav .site-carousel-count");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let active = 0;

    const slideLeft = (index) => {
      const slide = slides[index];
      if (!slide) return 0;
      const trackBox = track.getBoundingClientRect();
      const slideBox = slide.getBoundingClientRect();
      return track.scrollLeft + (slideBox.left - trackBox.left) - (trackBox.width - slideBox.width) / 2;
    };

    const setActive = (index, scroll = false) => {
      const nextIndex = (index + slides.length) % slides.length;
      if (nextIndex !== active) pauseSlideMedia(slides[active]);
      active = nextIndex;
      slides.forEach((slide, i) => {
        slide.setAttribute("aria-hidden", i === active ? "false" : "true");
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === active);
        if (i === active) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      if (count) count.textContent = `${active + 1} / ${slides.length}`;
      slides[active]?.querySelectorAll("iframe").forEach((iframe) => {
        if (!iframe.getAttribute("src") && iframe.dataset.src) iframe.src = iframe.dataset.src;
      });
      if (scroll) {
        track.scrollTo({ left: slideLeft(active), behavior: reduceMotion ? "auto" : "smooth" });
      }
    };

    prev?.addEventListener("click", () => setActive(active - 1, true));
    next?.addEventListener("click", () => setActive(active + 1, true));
    dots.forEach((dot, i) => dot.addEventListener("click", () => setActive(i, true)));

    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        setActive(active - 1, true);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        setActive(active + 1, true);
      }
    });

    slides.forEach((slide, i) => {
      slide.querySelectorAll("iframe").forEach((iframe) => {
        const src = iframe.getAttribute("src");
        if (!src) return;
        iframe.dataset.src = src;
        if (i !== 0) iframe.removeAttribute("src");
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        const index = slides.indexOf(visible.target);
        if (index >= 0) setActive(index);
      },
      { root: track, threshold: 0.55 },
    );
    slides.forEach((slide) => observer.observe(slide));

    const slideIndexForId = (id) =>
      id ? slides.findIndex((slide) => slide.querySelector(`#${CSS.escape(id)}`)) : -1;

    const goToId = (id) => {
      const idx = slideIndexForId(id);
      if (idx >= 0) setActive(idx, true);
    };

    window.addEventListener("hashchange", () => goToId(location.hash.slice(1)));
    const initial = slideIndexForId(location.hash.slice(1));
    requestAnimationFrame(() => setActive(initial >= 0 ? initial : 0, true));
  }
</script>
