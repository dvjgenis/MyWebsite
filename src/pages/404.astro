---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist or has moved.">
  <section class="mx-auto max-w-2xl px-4 py-20 md:py-28 text-center">
    <p class="text-xs uppercase tracking-[0.18em] text-ink-muted mb-4">Error 404</p>
    <h1 class="font-display text-[clamp(2.4rem,6vw,3.5rem)] tracking-tight text-ink mb-4 text-wrap-balance">
      This page has moved on
    </h1>
    <p class="text-ink-muted leading-relaxed mb-8">
      The link may be outdated, or the page lives under a new path. Try home, or jump to a main section.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn btn-primary">Back home</a>
      <a href="/about/" class="btn btn-ghost">About</a>
      <a href="/initiatives/" class="btn btn-ghost">Initiatives</a>
      <a href="/contact/" class="btn btn-ghost">Contact</a>
    </div>
  </section>
</Base>
