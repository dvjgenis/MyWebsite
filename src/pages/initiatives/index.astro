---
import Base from "../../layouts/Base.astro";
import HubHero from "../../components/HubHero.astro";
import ColorTile from "../../components/ColorTile.astro";
import { getPageBySlug, getPageData } from "../../lib/pages";
import { initiativesTiles } from "../../data/tiles";

const result = await getPageBySlug("initiatives");
if (!result) throw new Error("Initiatives page missing");
const { page } = result;

const enriched = await Promise.all(
  initiativesTiles.map(async (tile) => ({
    ...tile,
    image: tile.image ?? (await getPageData(tile.href.replace(/^\/|\/$/g, "")))?.heroImage,
  })),
);
---

<Base title="Initiatives" description={page.data.description} image={page.data.heroImage} flushFooter>
  <HubHero
    title="Initiatives"
    description="Work, projects, speaking, leadership, study abroad, and awards — snapshots of the path so far."
    tone="initiatives"
    name="hub-initiatives"
  />
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 p-3">
    {
      enriched.map((tile, i) => (
        <ColorTile
          title={tile.title}
          href={tile.href}
          description={tile.description}
          tone={tile.tone}
          bg={tile.bg}
          fg={tile.fg}
          image={tile.image}
          delay={i * 50}
        />
      ))
    }
  </div>
</Base>
