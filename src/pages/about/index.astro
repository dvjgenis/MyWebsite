---
import Base from "../../layouts/Base.astro";
import HubHero from "../../components/HubHero.astro";
import ColorTile from "../../components/ColorTile.astro";
import { getPageBySlug } from "../../lib/pages";
import { aboutTiles } from "../../data/tiles";

const result = await getPageBySlug("about");
if (!result) throw new Error("About page missing");
const { page } = result;

const cardImages: Record<string, string | undefined> = {
  "/about/background/": page.data.cardBackgroundImage,
  "/about/education/": page.data.cardEducationImage,
  "/about/hobbies/": page.data.cardInvolvementsImage,
  "/about/resources/": page.data.cardResourcesImage,
};
---

<Base title="About Me" description={page.data.description} image={page.data.cardBackgroundImage} flushFooter>
  <HubHero
    title="About Me"
    description="Background, education, involvements, and the resources that have helped me along the way."
    tone="about"
    name="hub-about"
  />
  <div class="grid sm:grid-cols-2 gap-3 p-3">
    {
      aboutTiles.map((tile, i) => (
        <ColorTile
          title={tile.title}
          href={tile.href}
          description={tile.description}
          tone={tile.tone}
          bg={tile.bg}
          fg={tile.fg}
          image={cardImages[tile.href]}
          delay={i * 60}
        />
      ))
    }
  </div>
</Base>
